# Copy to .env (next to docker-compose.yml) and fill in.
# Leave both empty to use the scanner without Paperless; you can still
# download PDFs from the web app.

# Your Paperless-ngx address, as the Raspberry Pi reaches it.
DOXIE_PAPERLESS_URL=http://paperless.lan:8000

# Paperless → your name (top right) → My Profile → API Auth Token.
DOXIE_PAPERLESS_TOKEN=
